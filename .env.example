# ==============================================================================
# NEON SLITHER - Environment Configuration Template
# All production secrets must be set in your private environment / Portainer stack.
# NEVER commit real credentials, passwords, or session secrets to version control.
# ==============================================================================

# Application Port (standardized across host, container, and Node)
APP_PORT=3010

# Runtime Environment ('production' or 'development')
NODE_ENV=production

# Server identifier for logs and multi-node instances
GAME_SERVER_NAME=neon-slither-01

# Allowed Origins for CORS and WebSocket connections (comma-separated, without trailing slash)
# Example: http://localhost:3010,https://game.yourdomain.com
ALLOWED_ORIGINS=http://localhost:3010

# Maximum simultaneous active rooms before returning ROOM_LIMIT_REACHED (default: 32)
MAX_ROOMS=32

# Database Configuration (PostgreSQL internal container communication)
# Replace placeholders with strong, randomly generated credentials
POSTGRES_USER=your_postgres_username
POSTGRES_PASSWORD=your_strong_postgres_password
POSTGRES_DB=your_database_name

# Database URL used by Prisma ORM
# Format: postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public
DATABASE_URL=postgresql://your_postgres_username:your_strong_postgres_password@postgres:5432/your_database_name?schema=public

# Redis Configuration (Internal cache and session store)
# Format: redis://redis:6379
REDIS_URL=redis://redis:6379
