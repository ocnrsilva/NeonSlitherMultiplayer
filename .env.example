# ==============================================================================
# NEON SLITHER - Environment Variables Example
# Note: In shared production server, never publish database or redis ports.
# ==============================================================================

# Host port published for the container (host:container -> 3010:3000)
HOST_PORT=3010

# Runtime environment (development or production)
NODE_ENV=production

# Server identifier
GAME_SERVER_NAME=neon-slither-prod-01

# Database Configuration (PostgreSQL internal container communication)
POSTGRES_USER=neon_user
POSTGRES_PASSWORD=neon_super_secure_password_replace_in_prod
POSTGRES_DB=neon_slither
DATABASE_URL=postgresql://neon_user:neon_super_secure_password_replace_in_prod@postgres:5432/neon_slither?schema=public

# Redis Configuration (Internal cache and session store)
REDIS_URL=redis://redis:6379
