// Prisma Schema for Neon Slither Multiplayer
// Designed for PostgreSQL with clean separation between persistent match history and live gameplay

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String         @id @default(uuid())
  nickname     String         @db.VarChar(50)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  lastSeenAt   DateTime       @default(now()) @map("last_seen_at")
  
  sessions     GameSession[]
  matchPlayers MatchPlayer[]
  loadouts     PlayerLoadout[]
  scores       ScoreHistory[]

  @@index([nickname])
  @@map("users")
}

model GameSession {
  id           String       @id @default(uuid())
  userId       String?      @map("user_id")
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  socketId     String?      @map("socket_id") @db.VarChar(100)
  userAgent    String?      @map("user_agent") @db.VarChar(255)
  isActive     Boolean      @default(true) @map("is_active")
  createdAt    DateTime     @default(now()) @map("created_at")
  endedAt      DateTime?    @map("ended_at")

  matchPlayers MatchPlayer[]

  @@index([userId])
  @@index([socketId])
  @@map("game_sessions")
}

model Match {
  id          String        @id @default(uuid())
  serverName  String        @default("neon-slither-01") @map("server_name") @db.VarChar(100)
  startedAt   DateTime      @default(now()) @map("started_at")
  endedAt     DateTime?     @map("ended_at")
  maxPlayers  Int           @default(100) @map("max_players")
  
  players     MatchPlayer[]

  @@map("matches")
}

model MatchPlayer {
  id           String       @id @default(uuid())
  matchId      String       @map("match_id")
  match        Match        @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId       String?      @map("user_id")
  user         User?        @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessionId    String?      @map("session_id")
  session      GameSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  nickname     String       @db.VarChar(50)
  joinedAt     DateTime     @default(now()) @map("joined_at")
  leftAt       DateTime?    @map("left_at")
  finalScore   Int          @default(0) @map("final_score")
  kills        Int          @default(0)
  isWinner     Boolean      @default(false) @map("is_winner")
  loadoutUsed  Json?        @map("loadout_used")

  @@index([matchId])
  @@index([userId])
  @@map("match_players")
}

model ScoreHistory {
  id          String   @id @default(uuid())
  userId      String?  @map("user_id")
  user        User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  nickname    String   @db.VarChar(50)
  score       Int
  survivalSec Int      @default(0) @map("survival_sec")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([score(sort: Desc)])
  @@index([userId])
  @@map("score_history")
}

// Prepared for future store / loadout features
model GameItem {
  id          String              @id @default(uuid())
  code        String              @unique @db.VarChar(50)
  name        String              @db.VarChar(100)
  description String?
  category    String              @default("ABILITY") @db.VarChar(50)
  createdAt   DateTime            @default(now()) @map("created_at")

  loadoutItems PlayerLoadoutItem[]

  @@map("game_items")
}

model PlayerLoadout {
  id          String              @id @default(uuid())
  userId      String              @map("user_id")
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  name        String              @default("Default") @db.VarChar(50)
  createdAt   DateTime            @default(now()) @map("created_at")
  updatedAt   DateTime            @updatedAt @map("updated_at")

  items       PlayerLoadoutItem[]

  @@index([userId])
  @@map("player_loadouts")
}

model PlayerLoadoutItem {
  id          String        @id @default(uuid())
  loadoutId   String        @map("loadout_id")
  loadout     PlayerLoadout @relation(fields: [loadoutId], references: [id], onDelete: Cascade)
  itemId      String        @map("item_id")
  item        GameItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  isEnabled   Boolean       @default(true) @map("is_enabled")

  @@unique([loadoutId, itemId])
  @@map("player_loadout_items")
}
